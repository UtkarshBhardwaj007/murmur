<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Murmur is signed with the hardened runtime; without this entitlement
       macOS hard-denies microphone access (no prompt, no System Settings
       entry). Keep in sync with the release-workflow signature check. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
